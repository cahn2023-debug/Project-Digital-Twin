{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Digital Twin",
  "version": "0.1.0",
  "identifier": "com.projectdigitaltwin.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm --parallel --filter @project/web --filter @project/server dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [{ "title": "Project Digital Twin", "width": 1280, "height": 800 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.svg"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
